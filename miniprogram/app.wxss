/* app.wxss 全局样式 */

page {
  --primary: #1989fa;
  --primary-light: #e8f3ff;
  --success: #07c160;
  --warning: #ff976a;
  --danger: #ee0a24;
  --text-primary: #333;
  --text-secondary: #666;
  --text-placeholder: #999;
  --bg-page: #f5f5f5;
  --bg-card: #ffffff;
  --border-color: #ebedf0;
  --shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-page);
  line-height: 1.6;
}

view, button, text, image {
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
}

.card {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--text-primary);
}

/* 按钮样式覆盖 */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 20rpx 40rpx;
  border: none;
}

.btn-primary[disabled] {
  background: #ccc;
  color: #fff;
}

.btn-ghost {
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border: none;
}

.btn-danger {
  background: #fff;
  color: var(--danger);
  border: 1rpx solid var(--danger);
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
}

/* 文字 */
.text-primary { color: var(--primary); }
.text-warning { color: var(--warning); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-secondary { color: var(--text-secondary); }
.text-placeholder { color: var(--text-placeholder); }

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: var(--primary-light);
  color: var(--primary);
  margin-right: 12rpx;
}

.tag-warning {
  background: #fff7e8;
  color: var(--warning);
}

.tag-success {
  background: #e8f9e7;
  color: var(--success);
}

.tag-danger {
  background: #ffebee;
  color: var(--danger);
}

/* 加载/空状态 */
.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-placeholder);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.loading {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-secondary);
}