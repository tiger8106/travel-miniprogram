.pp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.pp-box {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
}

.pp-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.pp-body {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
}

.pp-link {
  color: #1989fa;
}

.pp-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #888;
}

.pp-btns {
  display: flex;
  margin-top: 36rpx;
}

.pp-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin: 0;
  padding: 0;
}

.pp-btn::after {
  border: none;
}

.pp-btn.cancel {
  margin-right: 16rpx;
  background: #f2f3f5;
  color: #666;
}

.pp-btn.ok {
  background: #1989fa;
  color: #fff;
}
