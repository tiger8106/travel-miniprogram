.activity-item {
  margin-bottom: 16rpx;
}

/* 已结束：整体置灰 */
.item-past {
  opacity: 0.45;
}

.item-past .time-text {
  color: var(--text-secondary);
}

.past-tag {
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  background: #eee;
  color: var(--text-secondary);
}

.time-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.time-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.time-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}

.activity-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.location-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.arrow {
  color: var(--primary);
  margin: 0 8rpx;
}

.note {
  background: #f8f8f8;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  line-height: 1.6;
}

/* 导航行：独占一行；有中间点时多段按钮换行铺开 */
.nav-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

/* 多段导航：每个链接独占一行（block 模式，间距由组件内联 style 控制） */
.nav-multi {
  display: block;
}

.nav-multi map-button {
  max-width: 100%;
}

/* 操作行：编辑 / 删除 单独一行，右对齐 */
.btn-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  margin-left: 20rpx;
  background: var(--primary-light);
  color: var(--primary);
}

.btn-row .action-btn:first-child {
  margin-left: 0;
}

.action-btn.danger {
  background: #ffebee;
  color: var(--danger);
}

/* ============================================================
   编辑抽屉 & 删除确认（通用）
   ============================================================ */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  animation: fade-in 0.2s ease-out;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes pop-in {
  from { transform: scale(0.88); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* ---------- 底部抽屉 ---------- */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
  animation: sheet-up 0.3s cubic-bezier(0.22, 0.8, 0.3, 1);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e0e0e0;
  margin: 16rpx auto 8rpx;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 32rpx 16rpx;
}

.sheet-head-left {
  flex: 1;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
}

.sheet-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #909399;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-body {
  max-height: 62vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4a4a4a;
  margin-bottom: 14rpx;
}

/* 时间胶囊 */
.time-row-edit {
  display: flex;
  align-items: center;
}

.time-picker {
  flex: 1;
}

.time-pill {
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  display: flex;
  flex-direction: column;
  border: 2rpx solid transparent;
}

.time-pill-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.time-pill-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

.time-dash {
  padding: 0 20rpx;
  color: #c8c9cc;
}

/* 输入框 */
.input-area {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 88rpx;
  color: #1a1a1a;
}

.ph {
  color: #c0c4cc;
  font-size: 26rpx;
}

/* 地点区 */
.place-box {
  position: relative;
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 8rpx 0;
}

.place-line {
  display: flex;
  align-items: center;
  padding: 16rpx 80rpx 16rpx 24rpx;
}

.place-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  font-size: 22rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.place-dot.start {
  background: #52c41a;
}

.place-dot.end {
  background: #ff6b6b;
}

.place-dot.mid {
  background: #1989fa;
}

.place-del {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  color: #c0c4cc;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.place-add {
  margin-top: 14rpx;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  border: 2rpx dashed #c8dff9;
  color: var(--primary);
  font-size: 26rpx;
}

.place-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.place-divider {
  height: 1rpx;
  background: #ebedf0;
  margin-left: 86rpx;
}

.place-swap {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--primary);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 选项 chips */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  display: flex;
  align-items: center;
  padding: 14rpx 26rpx;
  border-radius: 32rpx;
  background: #f7f8fa;
  color: #5a5a5a;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.chip-icon {
  margin-right: 8rpx;
}

.chip-on {
  background: var(--primary-light);
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}

/* 底部按钮 */
.sheet-foot {
  display: flex;
  padding: 16rpx 32rpx 8rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
}

.btn-cancel {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 44rpx;
  background: #f2f3f5;
  color: #5a5a5a;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-save {
  flex: 2;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 44rpx;
  margin-left: 24rpx;
  background: linear-gradient(135deg, #1989fa, #5cb1ff);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(25, 137, 250, 0.28);
}

/* ---------- 删除确认卡 ---------- */
.confirm-mask {
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-card {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
  animation: pop-in 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.2);
}

.confirm-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #ffebee;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.confirm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.confirm-text {
  font-size: 27rpx;
  color: #606266;
  margin-top: 16rpx;
  line-height: 1.5;
  word-break: break-all;
}

.confirm-hint {
  font-size: 23rpx;
  color: #c0c4cc;
  margin-top: 10rpx;
}

.confirm-actions {
  display: flex;
  margin-top: 40rpx;
}

.btn-del {
  flex: 2;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 44rpx;
  margin-left: 24rpx;
  background: linear-gradient(135deg, #ff6b6b, #e74c3c);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(231, 76, 60, 0.28);
}
