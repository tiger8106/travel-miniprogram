.day-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}

.day-card.today {
  background: var(--primary-light);
  border-left: 8rpx solid var(--primary);
}

.day-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  flex-shrink: 0;
}

.day-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
}

.day-weekday {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.day-content {
  flex: 1;
  padding: 0 16rpx;
}

.day-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.day-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.day-meta {
  margin-top: 12rpx;
}

.day-arrow {
  color: var(--text-placeholder);
  font-size: 40rpx;
}