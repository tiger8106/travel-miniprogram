.gate {
  background: var(--bg-card, #fff);
  border-radius: 20rpx;
  padding: 64rpx 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  margin-top: 80rpx;
}

.gate-icon {
  font-size: 76rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.gate-tip {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.gate-desc {
  font-size: 25rpx;
  color: #8a9099;
  margin-top: 12rpx;
  line-height: 1.6;
}

.gate-btn {
  margin: 40rpx auto 0;
  width: 320rpx;
  padding: 22rpx 0;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #4a90e2, #357abd);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 226, 0.28);
}

.gate-btn.disabled {
  opacity: 0.6;
}
