<view class="alarm-card card {{item.completed ? 'alarm-completed' : (item.status === 'past' ? 'alarm-past' : '')}}">
  <view class="alarm-header">
    <text class="alarm-icon">{{icon}}</text>
    <view class="alarm-info">
      <view class="alarm-title">{{item.title}}</view>
      <view class="alarm-time">提醒 {{item.remindFriendly || item.friendly}}</view>
    </view>
    <text class="tag {{item.completed ? 'tag-done' : (item.status === 'past' ? '' : (item.status === 'soon' ? 'tag-warning' : 'tag-success'))}}">
      {{statusLabel}}
    </text>
  </view>

  <view class="alarm-action-time">办理：{{item.actionFriendly || item.friendly}}</view>

  <view wx:if="{{displayInfo}}" class="alarm-usage">{{displayInfo}}</view>

  <view class="alarm-actions">
    <!-- 每个操作是一个完整的“图标 + 文字”组合；窄屏换行时组合不会被拆成两个按钮。 -->
    <view class="action-pair primary" bindtap="onTapCalendar">
      <text class="action-icon">📅</text><text class="action-label">日历</text>
    </view>
    <view wx:if="{{devMode}}" class="action-pair" bindtap="onTapTest">
      <text class="action-icon">🔔</text><text class="action-label">测试</text>
    </view>
    <view class="action-pair complete" bindtap="onTapComplete">
      <text class="action-icon">{{item.completed ? '↩' : '✓'}}</text><text class="action-label">{{item.completed ? '恢复待办' : '已完成'}}</text>
    </view>
    <view class="action-pair" bindtap="onTapEdit">
      <text class="action-icon">✏️</text><text class="action-label">编辑</text>
    </view>
    <view class="action-pair danger" bindtap="onTapDelete">
      <text class="action-icon">🗑</text><text class="action-label">删除</text>
    </view>
  </view>
</view>
