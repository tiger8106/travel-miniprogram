.alarm-card {
  margin-bottom: 16rpx;
}

/* 提醒时间已到但尚未完成：仍是进行中，不按“过期”置灰 */
.alarm-past {
  opacity: 1;
}

.alarm-completed {
  opacity: 0.72;
  background: #f7fbf8;
}

.alarm-header {
  display: flex;
  align-items: center;
}

.alarm-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.alarm-info {
  flex: 1;
}

.alarm-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.alarm-time {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

.alarm-action-time {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.alarm-note {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.alarm-usage {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  background: #f0f7ff;
  border-radius: 8rpx;
  font-size: 25rpx;
  color: #3478b9;
  line-height: 1.55;
}

.alarm-actions {
  width: 100%;
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.action-pair {
  flex: 1 1 112rpx;
  min-width: 112rpx;
  min-height: 92rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  background: var(--primary-light);
  color: var(--primary);
  text-align: center;
}

.action-icon,
.action-label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}

.action-icon {
  min-height: 48rpx;
  padding: 7rpx 4rpx 2rpx;
  font-size: 29rpx;
}

.action-label {
  min-height: 40rpx;
  padding: 2rpx 4rpx 8rpx;
  font-size: 22rpx;
  line-height: 1.25;
  white-space: normal;
  word-break: keep-all;
}

.action-pair.primary {
  background: var(--primary);
  color: #fff;
}

.action-pair.danger {
  background: #ffebee;
  color: var(--danger);
}

.action-pair.complete {
  background: #e8f7ed;
  color: #29964b;
}

@media (max-width: 360px) {
  .action-pair {
    flex-basis: 132rpx;
  }
}
