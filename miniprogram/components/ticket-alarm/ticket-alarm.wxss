.alarm-card {
  margin-bottom: 16rpx;
}

/* 提醒时间已到但尚未完成：仍是进行中，不按“过期”置灰 */
.alarm-past {
  opacity: 1;
}

.alarm-completed {
  opacity: 0.72;
  background: #f7fbf8;
}

.alarm-header {
  display: flex;
  align-items: center;
}

.alarm-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.alarm-info {
  flex: 1;
}

.alarm-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.alarm-time {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

.alarm-action-time {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
}

.alarm-note {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.alarm-usage {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  background: #f0f7ff;
  border-radius: 8rpx;
  font-size: 25rpx;
  color: #3478b9;
  line-height: 1.55;
}

.alarm-actions {
  width: 100%;
  margin-top: 16rpx;
}

.action-row {
  display: flex;
  width: 100%;
}

.action-cell {
  flex: 1;
  min-width: 0;
  min-height: 52rpx;
  box-sizing: border-box;
  margin-right: 12rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-light);
  color: var(--primary);
}

.action-cell:last-child {
  margin-right: 0;
}

.action-icon-row {
  margin-bottom: 8rpx;
}

.action-icon-row .action-cell {
  padding: 8rpx 0;
  font-size: 30rpx;
}

.action-text-row .action-cell {
  padding: 9rpx 2rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.action-cell.primary {
  background: var(--primary);
  color: #fff;
}

.action-cell.danger {
  background: #ffebee;
  color: var(--danger);
}

.action-cell.complete {
  background: #e8f7ed;
  color: #29964b;
}
