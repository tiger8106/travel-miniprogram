.map-btn {
  display: flex;
  align-items: center;
  background: var(--primary-light);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  max-width: 480rpx;
}

/* 独占一行：多段导航（中间点）时每个链接各占一行、通栏 */
.map-btn-block {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.map-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.map-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-arrow {
  color: var(--primary);
  font-size: 28rpx;
  margin-left: 8rpx;
}