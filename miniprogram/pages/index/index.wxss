.header {
  background: linear-gradient(135deg, #1989fa, #5cb1ff);
  color: #fff;
}

.header .card-title {
  color: #fff;
  font-size: 36rpx;
}

.header .text-secondary {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 8rpx;
}

.trip-summary {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

/* 攻略切换行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 26rpx;
}

/* 顶部攻略操作：移出首页 / 删除 */
.trip-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.trip-action {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 26rpx;
}

.trip-action.danger {
  background: rgba(231, 76, 60, 0.28);
}

.empty-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 32rpx;
}

.alarm-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.alarm-row:last-child {
  border-bottom: none;
}

.alarm-time {
  width: 140rpx;
  flex-shrink: 0;
  color: var(--primary);
  font-weight: 600;
  font-size: 26rpx;
}

.alarm-content {
  flex: 1;
}

.alarm-title {
  font-size: 28rpx;
  font-weight: 500;
}

.day-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.day-row:last-child {
  border-bottom: none;
}

.day-row-active {
  background: var(--primary-light);
  border-radius: 12rpx;
}

/* 已过期的天数：整体置灰 */
.day-row-past {
  opacity: 0.55;
}

.day-label {
  font-size: 30rpx;
  font-weight: 500;
}

.day-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}