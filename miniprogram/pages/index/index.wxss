.header {
  background: linear-gradient(135deg, #1989fa, #5cb1ff);
  color: #fff;
}

.header .card-title {
  color: #fff;
  font-size: 36rpx;
  padding-right: 80rpx; /* 给右上角 ⋯ 按钮留位 */
}

.header .text-secondary {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 8rpx;
}

.trip-summary {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}

/* 攻略切换行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 26rpx;
}

/* 顶部攻略操作：右上角 ⋯ 菜单（移出首页 / 删除行程收进去） */
.header {
  position: relative;
}

.trip-menu-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: transparent;
}

.trip-menu-btn {
  position: absolute;
  top: 23rpx; /* 卡片内边距 24 + 标题行高一半(36*1.6/2) - 按钮半高 = 22.8，与标题行居中对齐 */
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  z-index: 31;
}

.trip-menu-btn:active {
  background: rgba(255, 255, 255, 0.34);
}

.trip-menu {
  position: absolute;
  top: 86rpx;
  right: 20rpx;
  min-width: 240rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 0;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.18);
  z-index: 32;
  animation: menu-pop 0.18s cubic-bezier(0.2, 0.9, 0.3, 1.15);
  transform-origin: top right;
}

@keyframes menu-pop {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}

.trip-menu-item {
  padding: 22rpx 30rpx;
  font-size: 27rpx;
  color: #333;
}

.trip-menu-item:active {
  background: #f5f7fa;
}

.trip-menu-item.danger {
  color: #e74c3c;
}

.empty-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 32rpx;
}

/* ===== 此刻行程（正在进行 / 即将进行）===== */
.now-card {
  padding-bottom: 12rpx;
}

.now-head-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.now-head-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
}

.now-emoji {
  margin-right: 10rpx;
}

.now-more {
  font-size: 24rpx;
  color: var(--text-placeholder);
  padding: 4rpx 8rpx;
}

.now-list {
  padding-top: 8rpx;
}

.now-item {
  display: flex;
  align-items: stretch;
}

/* 左侧时间轴：圆点 + 竖线 */
.now-rail {
  width: 40rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 22rpx;
}

.now-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #d9e7f7;
  flex-shrink: 0;
}

.now-dot.live {
  background: var(--primary);
  animation: nowPulse 1.8s ease-out infinite;
}

@keyframes nowPulse {
  0%   { box-shadow: 0 0 0 0 rgba(25, 137, 250, 0.35); }
  70%  { box-shadow: 0 0 0 16rpx rgba(25, 137, 250, 0); }
  100% { box-shadow: 0 0 0 0 rgba(25, 137, 250, 0); }
}

.now-line {
  flex: 1;
  width: 2rpx;
  background: var(--border-color);
  margin-top: 6rpx;
}

.now-body {
  flex: 1;
  margin: 10rpx 0 10rpx 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f7fafd;
}

.now-item.live .now-body {
  background: linear-gradient(135deg, #e9f3ff, #f7fbff);
}

.now-line1 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.now-time {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: 8rpx;
}

.now-end {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 10rpx;
}

.now-status {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  color: var(--text-secondary);
  margin-right: 10rpx;
}

.now-status.live {
  background: var(--primary);
  color: #fff;
}

.now-day {
  font-size: 20rpx;
  color: var(--text-placeholder);
}

.now-title-text {
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.5;
  margin-top: 6rpx;
}

.now-route {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.now-route-icon {
  margin-right: 6rpx;
}

.now-route-text {
  flex: 1;
  line-height: 1.5;
}

.now-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--border-color);
}

.now-hint {
  font-size: 22rpx;
  color: var(--primary);
}

.now-hint.dim {
  color: var(--text-placeholder);
}

.now-detail {
  font-size: 22rpx;
  color: var(--text-secondary);
  padding: 4rpx 10rpx;
}

.day-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.day-row:last-child {
  border-bottom: none;
}

.day-row-active {
  background: var(--primary-light);
  border-radius: 12rpx;
}

/* 已过期的天数：整体置灰 */
.day-row-past {
  opacity: 0.55;
}

.day-label {
  font-size: 30rpx;
  font-weight: 500;
}

.day-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}