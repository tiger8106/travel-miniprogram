<view class="container">
  <!-- 未登录：不展示任何行程信息，只显示登录门禁卡 -->
  <login-gate wx:if="{{needLogin}}" tip="登录后查看和管理你的行程" bind:success="onLoginSuccess" />

  <block wx:else>
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <!-- 空状态：没有进行中的攻略 -->
  <view wx:elif="{{!trip}}" class="empty">
    <text class="empty-icon">🗺️</text>
    <view>{{totalTrips ? '进行中的行程都结束了' : '还没有行程，先上传一份攻略吧'}}</view>
    <view class="empty-actions">
      <button wx:if="{{totalTrips}}" class="btn-ghost" bindtap="onTapMyTrips">🗂️ 我的行程</button>
      <button class="btn-primary" bindtap="onTapUpload" style="margin-top: 24rpx;">📤 上传攻略</button>
      <button class="btn-primary" bindtap="onTapPlanner" style="margin-top: 24rpx;">✨ 制定攻略</button>
    </view>
  </view>

  <!-- 已加载 -->
  <block wx:else>
    <!-- ⋯ 菜单展开时：点外面收起 -->
    <view wx:if="{{tripMenuOpen}}" class="trip-menu-mask" bindtap="onCloseTripMenu" catchtouchmove="noop"></view>
    <!-- 顶部行程概览：点击切换攻略 -->
    <view class="header card">
      <!-- 右上角 ⋯ 操作菜单 -->
      <view class="trip-menu-btn" catchtap="onToggleTripMenu">···</view>
      <view wx:if="{{tripMenuOpen}}" class="trip-menu">
        <view wx:if="{{canRemoveFromHome}}" class="trip-menu-item" catchtap="onRemoveFromHome">↩️ 移出首页</view>
        <view class="trip-menu-item danger" catchtap="onDeleteTrip">🗑 删除行程</view>
      </view>

      <view class="card-title">
        {{trip.title || '当前行程'}}
        <text wx:if="{{tripEnded}}" class="tag tag-success" style="margin-left: 12rpx;">已结束</text>
      </view>
      <view class="text-secondary">{{dateText}}</view>
      <view wx:if="{{trip.summary}}" class="trip-summary">{{trip.summary}}</view>
      <picker wx:if="{{homeTrips.length > 1}}"
              mode="selector"
              range="{{homeTripLabels}}"
              value="{{tripIdx}}"
              bindchange="onTripChange">
        <view class="switch-row">
          <text>🔄 切换攻略（{{tripIdx + 1}}/{{homeTrips.length}}）</text>
          <text>▸</text>
        </view>
      </picker>
    </view>

    <!-- 此刻行程：正在进行 / 即将进行，点卡片直接导航 -->
    <view wx:if="{{nowItems.length}}" class="card now-card">
      <view class="now-head-bar">
        <view class="now-head-title">
          <text class="now-emoji">🧭</text>
          <text>{{nowTitle}}</text>
        </view>
        <text class="now-more" data-idx="0" catchtap="onTapNowDetail">查看当天 ›</text>
      </view>

      <view class="now-list">
        <view wx:for="{{nowItems}}" wx:key="key"
              class="now-item {{item.ongoing ? 'live' : ''}}"
              data-idx="{{index}}"
              bindtap="onTapNowNav">
          <!-- 左侧时间轴 -->
          <view class="now-rail">
            <view class="now-dot {{item.ongoing ? 'live' : ''}}"></view>
            <view wx:if="{{index !== nowItems.length - 1}}" class="now-line"></view>
          </view>

          <view class="now-body">
            <view class="now-line1">
              <text class="now-time">{{item.timeText}}</text>
              <text wx:if="{{item.endText}}" class="now-end">→ {{item.endText}}</text>
              <text class="now-status {{item.ongoing ? 'live' : ''}}">{{item.statusText}}</text>
            </view>

            <view class="now-date-row">
              <text class="now-date-icon">📅</text>
              <text class="now-date-text">{{item.dateText}}</text>
              <text class="now-date-day">{{item.dayLabel}}</text>
            </view>

            <view class="now-title-text">{{item.title}}</view>

            <view wx:if="{{item.routeText}}" class="now-route">
              <text class="now-route-icon">📍</text>
              <text class="now-route-text">{{item.routeText}}</text>
            </view>

            <view class="now-actions">
              <text wx:if="{{item.hasNav}}" class="now-hint">🧭 点卡片一键导航</text>
              <text wx:else class="now-hint dim">该安排未填地点</text>
              <text class="now-detail" data-idx="{{index}}" catchtap="onTapNowDetail">详情 ›</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 没有正在进行/即将进行的安排（攻略已全部结束，或没有带时间的条目）→ 给明确状态，别整块消失 -->
    <view wx:elif="{{trip}}" class="card now-empty">
      <view class="now-empty-icon">🚩</view>
      <view class="now-empty-text">没有正在进行或即将进行的行程</view>
      <view class="now-empty-sub">{{tripEnded ? '本次攻略的安排已全部结束' : '攻略里暂无带时间的安排'}}</view>
    </view>

    <!-- 每日行程 -->
    <view class="card">
      <view class="card-title">📅 每日安排</view>
      <block wx:for="{{days}}" wx:key="date" wx:for-index="idx">
        <view class="day-row {{idx === todayIdx ? 'day-row-active' : ''}} {{item.past ? 'day-row-past' : ''}}"
              data-idx="{{idx}}"
              bindtap="onTapDay">
          <view class="day-label">{{item.label}}</view>
          <view class="day-meta">
            <text class="tag">{{item.count}} 项</text>
            <text wx:if="{{idx === todayIdx}}" class="tag tag-warning">今天</text>
            <text wx:if="{{item.past}}" class="tag">已结束</text>
            <text class="text-secondary" style="font-size: 22rpx;">查看详情 ›</text>
          </view>
        </view>
      </block>
    </view>
  </block>
  </block>
</view>