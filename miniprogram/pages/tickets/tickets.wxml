<view class="container">
  <!-- 未登录：不展示闹钟 -->
  <login-gate wx:if="{{needLogin}}" tip="登录后查看和管理闹钟" bind:success="onLoginSuccess" />

  <block wx:else>
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{!alarms.length && !editForm}}" class="empty">
    <text class="empty-icon">⏰</text>
    <view>暂无闹钟</view>
    <view class="text-secondary" style="font-size: 24rpx; margin-top: 16rpx;">
      上传攻略后会自动从文档提取抢票时间
    </view>
    <button class="btn-primary" bindtap="onAdd" style="margin-top: 32rpx;">+ 手动添加闹钟</button>
    <view wx:if="{{devMode}}" class="add-btn" bindtap="onSelfCheck" style="margin-top: 24rpx;">🩺 订阅消息推送自检</view>
  </view>

  <block wx:else>
    <!-- ===== 提醒设置（紧凑两行，不再抢视觉） ===== -->
    <view class="card settings-card">
      <view class="settings-row">
        <text class="settings-icon">⏱️</text>
        <view class="settings-main">
          <view class="settings-label">提前提醒</view>
          <view class="settings-sub">小程序内提醒 & 写入日历的提前量</view>
        </view>
        <picker mode="selector"
                range="{{advanceOptionsLabel}}"
                value="{{advanceIdx}}"
                bindchange="onAdvanceChange">
          <view class="settings-value">提前 {{advanceMin}} 分钟 ›</view>
        </picker>
      </view>

      <view class="settings-divider"></view>

      <view class="settings-row" bindtap="onSyncAllToCalendar">
        <text class="settings-icon">📅</text>
        <view class="settings-main">
          <view class="settings-label">同步到系统日历</view>
          <view class="settings-sub">系统日历提醒，微信不用打开</view>
        </view>
        <view class="settings-value {{pendingCount ? '' : 'muted'}}">
          {{pendingCount ? pendingCount + ' 个 ›' : '无待同步'}}
        </view>
      </view>
      <view wx:if="{{devMode}}" class="settings-divider"></view>

      <view wx:if="{{devMode}}" class="settings-row" bindtap="onSelfCheck">
        <text class="settings-icon">🩺</text>
        <view class="settings-main">
          <view class="settings-label">推送自检</view>
          <view class="settings-sub">检查模板 / 云函数版本，不发送消息</view>
        </view>
        <view class="settings-value">体检 ›</view>
      </view>
    </view>

    <!-- ===== 正在进行 / 即将进行（和首页「此刻行程」同一套视觉） ===== -->
    <block wx:if="{{nowAlarms.length}}">
      <view class="card now-card">
        <view class="now-head-bar">
          <view class="now-head-title">
            <text class="now-emoji">🔔</text>
            正在进行 / 即将进行
          </view>
          <text class="now-more">{{nowAlarms.length}} 项待办</text>
        </view>
        <view class="now-list">
          <view wx:for="{{nowAlarms}}" wx:key="_id"
                class="now-item {{item.ongoing ? 'live' : ''}}"
                data-idx="{{index}}" bindtap="onTapNowAlarm">
            <view class="now-rail">
              <view class="now-dot {{item.ongoing ? 'live' : ''}}"></view>
              <view wx:if="{{index !== nowAlarms.length - 1}}" class="now-line"></view>
            </view>
            <view class="now-body">
              <view class="now-line1">
                <text class="now-time">{{item.friendly}}</text>
                <text class="now-status {{item.ongoing ? 'live' : ''}}">{{item.statusText}}</text>
                <text class="now-day">{{item.typeLabel}}</text>
              </view>
              <view class="now-title-text">{{item.title}}</view>
              <view wx:if="{{item.note}}" class="now-note">{{item.note}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{nowExtra}}" class="now-foot">还有 {{nowExtra}} 项提醒，见下方分类 · 点任意一条可编辑</view>
      </view>
    </block>
    <view wx:else class="card now-empty">
      <view class="now-empty-icon">🚩</view>
      <view class="now-empty-text">没有正在进行或即将进行的提醒</view>
      <view class="now-empty-sub">{{alarms.length ? '所有事项都还早，见下方分类待办' : '还没有任何提醒事项'}}</view>
    </view>

    <!-- ===== 分类待办：折叠卡，点击进入分类详情页 ===== -->
    <view wx:for="{{groups}}" wx:key="key" wx:for-item="g"
          class="group-card" data-key="{{g.key}}" bindtap="onTapGroup" hover-class="group-card-hover">
      <view class="group-left">
        <text class="group-icon">{{g.icon}}</text>
        <view class="group-main">
          <view class="group-line1">
            <text class="group-label">{{g.label}}</text>
            <text class="group-count">{{g.pending ? g.pending + ' 项待办' : '共 ' + g.count + ' 项'}}</text>
          </view>
          <view wx:if="{{g.nextTitle}}" class="group-next">下一条：{{g.nextTitle}} · {{g.nextTime}}</view>
        </view>
      </view>
      <text class="group-arrow">›</text>
    </view>
    <view wx:if="{{!groups.length}}" class="group-empty">所有分类都是空的</view>

    <view wx:if="{{!editForm}}" class="add-btn" bindtap="onAdd">+ 添加提醒事项</view>
  </block>
  </block>

  <!-- ===== 添加 / 编辑 · 底部抽屉 ===== -->
  <view wx:if="{{editForm}}" class="sheet-mask" bindtap="onCancelEdit" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>

      <view class="sheet-head">
        <view class="sheet-head-left">
          <view class="sheet-title">{{sheetMode === 'new' ? '添加闹钟' : '编辑闹钟'}}</view>
          <view class="sheet-sub">{{editForm.fireAtDate}} {{editForm.fireAtTime}}</view>
        </view>
        <view class="sheet-close" bindtap="onCancelEdit">✕</view>
      </view>

      <scroll-view scroll-y class="sheet-body">
        <!-- 标题 -->
        <view class="field">
          <view class="field-label">🔔 标题</view>
          <input class="input-line" placeholder="如：抢 G2249 高铁票" placeholder-class="ph"
                 value="{{editForm.title}}" data-field="title"
                 bindinput="onEditInput" maxlength="30" />
        </view>

        <!-- 提醒时间 -->
        <view class="field">
          <view class="field-label">⏰ 提醒时间</view>
          <view class="time-row-edit">
            <picker mode="date" value="{{editForm.fireAtDate}}" bindchange="onDateChange" class="time-picker">
              <view class="time-pill">
                <text class="time-pill-label">日期</text>
                <text class="time-pill-value">{{editForm.fireAtDate}}</text>
              </view>
            </picker>
            <text class="time-dash">—</text>
            <picker mode="time" value="{{editForm.fireAtTime}}" bindchange="onTimeChange" class="time-picker">
              <view class="time-pill">
                <text class="time-pill-label">时间</text>
                <text class="time-pill-value">{{editForm.fireAtTime}}</text>
              </view>
            </picker>
          </view>
        </view>

        <!-- 类型 -->
        <view class="field">
          <view class="field-label">🏷️ 类型</view>
          <view class="chip-wrap">
            <view wx:for="{{typeOptions}}" wx:key="value"
                  class="chip {{editForm.type === item.value ? 'chip-on' : ''}}"
                  data-value="{{item.value}}" bindtap="onEditType">
              <text class="chip-icon">{{item.icon}}</text>{{item.label}}
            </view>
          </view>
        </view>

        <!-- 备注 -->
        <view class="field">
          <view class="field-label">🗒️ 备注</view>
          <textarea class="input-area" placeholder="车次、检票口、注意事项等（选填）" placeholder-class="ph"
                    value="{{editForm.note}}" data-field="note"
                    bindinput="onEditInput" auto-height maxlength="100" />
        </view>
      </scroll-view>

      <view class="sheet-foot">
        <view class="btn-cancel" bindtap="onCancelEdit">取消</view>
        <view class="btn-save" bindtap="onSheetSave">{{sheetMode === 'new' ? '添加闹钟' : '保存修改'}}</view>
      </view>
    </view>
  </view>

  <!-- ===== 删除确认 ===== -->
  <view wx:if="{{delItem}}" class="sheet-mask confirm-mask" bindtap="onCancelDelete" catchtouchmove="noop">
    <view class="confirm-card" catchtap="noop">
      <view class="confirm-icon">🗑</view>
      <view class="confirm-title">删除这个闹钟？</view>
      <view class="confirm-text">{{delItem.title}}</view>
      <view class="confirm-hint">删除后将不再提醒</view>
      <view class="confirm-actions">
        <view class="btn-cancel" bindtap="onCancelDelete">取消</view>
        <view class="btn-del" bindtap="onConfirmDelete">删除</view>
      </view>
    </view>
  </view>

  <!-- 用户隐私保护授权弹窗（写入系统日历前由微信触发） -->
  <privacy-popup show="{{showPrivacy}}"
                 feature="同步到系统日历"
                 desc="我们只会在你主动点击同步时写入这条行程提醒，不会读取你日历里的其他日程，也不会对外分享。"
                 denyTip="未同意则无法写入系统日历"
                 bind:close="onClosePrivacy" />
</view>
