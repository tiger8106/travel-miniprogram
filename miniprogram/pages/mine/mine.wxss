.profile {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 24rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
}

.profile-openid {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  font-size: 28rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.info-row {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.info-row text {
  display: inline-block;
  min-width: 100rpx;
  color: var(--text-placeholder);
}
