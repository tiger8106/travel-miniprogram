.profile {
  display: flex;
  align-items: center;
}

/* 头像：可见部分是固定尺寸的 view，保证永远是正圆 */
.avatar {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--primary-light);
  margin: 0 24rpx 0 0;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* chooseAvatar 按钮：透明覆盖整个头像，点击区域即头像本身 */
.avatar-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 120rpx;
  height: 120rpx;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  opacity: 0;
  z-index: 2;
}

.avatar-cover::after {
  border: none;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  display: block;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.avatar-emoji {
  font-size: 60rpx;
  line-height: 1;
}

/* 右下角「换」小角标，提示头像可点击更换 */
.avatar-edit-tag {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.avatar-off {
  background: #f0f2f5;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
}

.profile-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 昵称输入框：长得像普通文字，点击即可编辑 */
.nick-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 0;
  margin: 0;
  min-height: 44rpx;
  line-height: 44rpx;
  background: transparent;
}

.login-btn {
  flex-shrink: 0;
  padding: 14rpx 30rpx;
  border-radius: 32rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.login-btn.disabled {
  opacity: 0.6;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  font-size: 28rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.logout-text {
  color: #e74c3c;
}

.info-row {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.info-row text {
  display: inline-block;
  min-width: 100rpx;
  color: var(--text-placeholder);
}
