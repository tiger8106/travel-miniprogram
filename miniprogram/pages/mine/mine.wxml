<view class="container">
  <!-- 个人资料 / 登录 -->
  <view class="card profile">
    <block wx:if="{{!loggedIn}}">
      <view class="avatar avatar-off">👤</view>
      <view class="profile-info">
        <view class="profile-name">未登录</view>
        <view class="profile-sub">微信登录后可在自己账号下保存攻略</view>
      </view>
      <view class="login-btn {{loggingIn ? 'disabled' : ''}}" bindtap="onLogin">
        {{loggingIn ? '登录中…' : '微信登录'}}
      </view>
    </block>
    <block wx:else>
      <!-- 头像：button 自己当圆形容器（官方 chooseAvatar 写法）。
           注意 chooseAvatar 是隐私接口，未同意隐私指引时点击会被微信静默拦截 -->
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" class="avatar-img" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-emoji">🐯</text>
        </view>
      </button>
      <view class="profile-info">
        <!-- 昵称行内直接编辑（微信官方 nickname 输入框；真机键盘上方有「使用微信昵称」） -->
        <input type="nickname" class="nick-input" value="{{profile.nickname}}"
               placeholder="点击填写昵称" maxlength="30" confirm-type="done"
               bindinput="onNickInput" bindblur="onNickBlur" bindconfirm="onNickBlur" />
        <view class="profile-sub">点头像换头像 · 点昵称改昵称</view>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="card-title">🧳 行程管理</view>
    <view class="menu-item" bindtap="onTapMyTrips">
      <view class="menu-item-left">
        <text>🗂️ 我的行程</text>
        <text class="menu-item-sub">查看已保存的攻略与行程安排</text>
      </view>
      <text class="text-placeholder">›</text>
    </view>
    <view class="menu-item" bindtap="onTapPay">
      <view class="menu-item-left">
        <text>💳 我的额度</text>
        <text class="menu-item-sub">{{quotaText}}</text>
      </view>
      <text class="text-placeholder">›</text>
    </view>
    <view class="menu-item" bindtap="onTapUpload">
      <view class="menu-item-left">
        <text>📤 上传新攻略</text>
        <text class="menu-item-sub">上传现成攻略文档，自动解析成行程</text>
      </view>
      <text class="text-placeholder">›</text>
    </view>
    <view class="menu-item" bindtap="onTapPlanner">
      <view class="menu-item-left">
        <text>✨ 制定新攻略</text>
        <text class="menu-item-sub">没现成攻略？填几个问题，AI 直接生成</text>
      </view>
      <text class="text-placeholder">›</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">⚙️ 设置与帮助</view>
    <view class="menu-item" bindtap="onTapAbout">
      <text>关于</text>
      <text class="text-placeholder">›</text>
    </view>
    <view class="menu-item" bindtap="onTapFeedback">
      <text>问题反馈</text>
      <text class="text-placeholder">›</text>
    </view>
    <view class="menu-item" wx:if="{{loggedIn}}" bindtap="onLogout">
      <text class="logout-text">退出登录</text>
      <text class="text-placeholder">›</text>
    </view>
  </view>

  <!-- 用户隐私保护授权弹窗（点头像/填昵称被微信拦截时触发） -->
  <privacy-popup show="{{showPrivacy}}" feature="设置头像和昵称"
                 desc="头像和昵称仅用于在你的账号内展示个人资料，不会采集相册、聊天记录或任何其他信息，也不会对外分享。"
                 denyTip="未同意则无法设置头像和昵称"
                 bind:close="onClosePrivacy" />
</view>
