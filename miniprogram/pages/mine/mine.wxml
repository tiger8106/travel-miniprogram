<view class="container">
  <!-- 个人资料 / 登录 -->
  <view class="card profile">
    <block wx:if="{{!loggedIn}}">
      <view class="avatar avatar-off">👤</view>
      <view class="profile-info">
        <view class="profile-name">未登录</view>
        <view class="profile-openid">微信登录后可在自己账号下保存攻略</view>
      </view>
      <view class="login-btn {{loggingIn ? 'disabled' : ''}}" bindtap="onLogin">
        {{loggingIn ? '登录中…' : '微信登录'}}
      </view>
    </block>
    <block wx:else>
      <button wx:if="{{editing}}" class="avatar avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" class="avatar-img" mode="aspectFill" />
        <text wx:else>📷</text>
      </button>
      <view wx:else class="avatar" bindtap="onEditProfile">
        <image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" class="avatar-img" mode="aspectFill" />
        <text wx:else>🐯</text>
      </view>
      <view class="profile-info">
        <view class="profile-name" bindtap="onEditProfile">{{profile.nickname || '旅行者'}}</view>
        <view class="profile-openid" bindtap="onCopyOpenid">{{openidShort ? 'ID: ' + openidShort : ''}}</view>
      </view>
    </block>
  </view>

  <!-- 编辑昵称 -->
  <view class="card" wx:if="{{editing}}">
    <view class="card-title">✏️ 编辑资料</view>
    <view class="edit-row">
      <input type="nickname" class="nick-input" value="{{profile.nickname}}"
             placeholder="点击填写昵称" bindinput="onNickInput" bindblur="onNickInput" />
      <view class="save-btn" bindtap="onSaveProfile">保存</view>
    </view>
    <view class="edit-hint">点头像可更换微信头像，昵称输入框会弹出微信昵称快捷填充</view>
  </view>

  <view class="card">
    <view class="card-title">🧳 行程管理</view>
    <view class="menu-item" bindtap="onTapMyTrips">
      <text>🗂️ 我的行程</text>
      <text class="text-placeholder">›</text>
    </view>
    <view class="menu-item" bindtap="onTapUpload">
      <text>📲 上传新攻略</text>
      <text class="text-placeholder">›</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">⚙️ 设置与帮助</view>
    <view class="menu-item" bindtap="onTapAbout">
      <text>关于</text>
      <text class="text-placeholder">›</text>
    </view>
    <view class="menu-item" bindtap="onTapFeedback">
      <text>问题反馈</text>
      <text class="text-placeholder">›</text>
    </view>
    <view class="menu-item" wx:if="{{loggedIn}}" bindtap="onLogout">
      <text class="logout-text">退出登录</text>
      <text class="text-placeholder">›</text>
    </view>
  </view>

  <view class="card" wx:if="{{systemInfo}}">
    <view class="card-title">📱 系统信息</view>
    <view class="info-row"><text>设备：</text>{{systemInfo.model}}</view>
    <view class="info-row"><text>系统：</text>{{systemInfo.system}}</view>
    <view class="info-row"><text>微信：</text>{{systemInfo.version}}</view>
  </view>
</view>
