/* pages/planner/planner.wxss */

.hero {
  background: linear-gradient(135deg, #1989fa, #4facfe);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(25, 137, 250, 0.25);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.92;
  line-height: 1.5;
}

/* ---------- 表单 ---------- */

.field {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.field:last-of-type {
  border-bottom: none;
}

.field-label {
  width: 160rpx;
  flex-shrink: 0;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.field-picker {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 6rpx 0;
}

.tip {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 12rpx;
  line-height: 1.5;
}

.days-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.sub-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin: 20rpx 0 12rpx;
}

.sub-label:first-of-type {
  margin-top: 4rpx;
}

/* ---------- 选项 chips ---------- */

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: var(--text-secondary);
  font-size: 26rpx;
  transition: all 0.15s;
}

.chip-on {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx var(--primary);
}

.area {
  width: 100%;
  min-height: 80rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ---------- 大纲 ---------- */

.trip-summary {
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.outline-list {
  margin-bottom: 24rpx;
}

.outline-item {
  display: flex;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.outline-day {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
}

.outline-body {
  flex: 1;
  min-width: 0;
}

.outline-date {
  font-size: 24rpx;
  color: var(--text-placeholder);
}

.outline-theme {
  font-size: 30rpx;
  font-weight: 600;
  margin: 4rpx 0 8rpx;
}

.outline-hl {
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.outline-night {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 10rpx;
}

/* ---------- 底部操作 ---------- */

.footer {
  padding-bottom: 24rpx;
}

.btn-row {
  display: flex;
  margin-bottom: 20rpx;
}

.btn-row .btn-ghost {
  flex: 1;
  margin: 0 12rpx 0 0;
}

.btn-row .btn-ghost:last-child {
  margin-right: 0;
}

.btn-generate {
  width: 100%;
}

.btn-generate.disabled {
  opacity: 0.7;
}

.footer-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 16rpx;
}
