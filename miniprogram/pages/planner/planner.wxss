/* pages/planner/planner.wxss */

.hero {
  background: linear-gradient(135deg, #1989fa, #4facfe);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(25, 137, 250, 0.25);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.92;
  line-height: 1.5;
}

/* ---------- 表单 ---------- */

.field {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.field:last-of-type {
  border-bottom: none;
}

.field-label {
  width: 160rpx;
  flex-shrink: 0;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.field-picker {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 6rpx 0;
}

.tip {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 12rpx;
  line-height: 1.5;
}

.days-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.sub-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin: 20rpx 0 12rpx;
}

.sub-label:first-of-type {
  margin-top: 4rpx;
}

/* ---------- 去程 / 返程时间行：日期 + 时刻同一行 ---------- */

.dt-row {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.dt-row:last-of-type {
  border-bottom: none;
}

.dt-label {
  display: block;
  font-size: 27rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.dt-pickers {
  display: flex;
  align-items: stretch;
}

.dt-date {
  flex: 1.5;
}

.dt-time {
  flex: 1;
  margin-left: 16rpx;
}

.dt-val {
  box-sizing: border-box;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  font-size: 29rpx;
  color: var(--text-primary);
  text-align: center;
  white-space: nowrap;
}

/* ---------- 选项 chips ---------- */

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: var(--text-secondary);
  font-size: 26rpx;
  transition: all 0.15s;
}

.chip-on {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx var(--primary);
}

.area {
  width: 100%;
  min-height: 80rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ---------- 大纲 ---------- */

.trip-summary {
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

/* 拖动排序容器：每天卡片高度固定（js 里按屏幕宽度换算成 px） */
.day-area {
  width: 100%;
  display: block;
  margin-bottom: 24rpx;
}

.day-mv {
  width: 100%;
  z-index: 2;
}

.outline-item {
  height: 100%;
  box-sizing: border-box;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.oi-head {
  display: flex;
  align-items: center;
}

.oi-grip {
  font-size: 28rpx;
  color: var(--text-placeholder);
  margin-right: 12rpx;
}

.oi-day {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--primary);
  margin-right: 12rpx;
}

.oi-date {
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-right: 12rpx;
}

.oi-city {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.oi-edit {
  font-size: 28rpx;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

.oi-theme {
  font-size: 29rpx;
  font-weight: 600;
  margin: 6rpx 0 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.oi-meta {
  display: flex;
  font-size: 23rpx;
  color: var(--text-placeholder);
}

.oi-move {
  margin-right: 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.oi-night {
  flex-shrink: 0;
}

.oi-hl {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 底部操作 ---------- */

.footer {
  padding-bottom: 24rpx;
}

.btn-row {
  display: flex;
  margin-bottom: 20rpx;
}

.btn-row .btn-ghost {
  flex: 1;
  margin: 0 12rpx 0 0;
}

.btn-row .btn-ghost:last-child {
  margin-right: 0;
}

.btn-generate {
  width: 100%;
}

.btn-generate.disabled {
  opacity: 0.7;
}

.footer-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-placeholder);
  margin-top: 16rpx;
}

/* 自定义兴趣偏好输入行 */
.custom-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.custom-input {
  flex: 1;
  background: var(--bg-color, #f5f7fa);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  min-width: 0;
}

.custom-add {
  margin-left: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: var(--primary-light, #e8f1ff);
  color: var(--primary, #3b7cff);
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.custom-add-off {
  opacity: 0.5;
}

/* ---------- 兴趣标签上的 ✕ ---------- */
.chip {
  display: inline-flex;
  align-items: center;
}

.chip-text {
  max-width: 220rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chip-x {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--text-placeholder);
  padding: 0 2rpx;
}

/* ---------- 编辑某一天 · 底部抽屉 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 80vh;
  background: var(--bg-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 16rpx 28rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-sub {
  font-size: 23rpx;
  color: var(--text-placeholder);
  margin-top: 6rpx;
}

.sheet-close {
  font-size: 32rpx;
  color: var(--text-placeholder);
  padding: 0 8rpx;
}

.sheet-body {
  flex: 1;
  min-height: 200rpx;
  max-height: 56vh;
}

/* 抽屉字段：label 一整行在上、输入框一整行在下。
   不能复用全局 .field（label 固定 160rpx 的横向布局）——长 label
   会被挤成几行、输入框被压扁，就是截图里排版乱的原因。 */
.sf {
  margin-bottom: 24rpx;
}

.sf-label {
  font-size: 27rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.sf-input {
  width: 100%;
  box-sizing: border-box;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 29rpx;
  line-height: 1.4;
  min-height: 84rpx;
}

.sf-area {
  width: 100%;
  box-sizing: border-box;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 29rpx;
  line-height: 1.5;
  min-height: 84rpx;
}

.sheet-foot {
  display: flex;
  margin-top: 20rpx;
}

.btn-cancel {
  flex: 1;
  margin-right: 16rpx;
  padding: 20rpx 0;
  text-align: center;
  border-radius: 12rpx;
  background: #f4f5f7;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.btn-save {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  border-radius: 12rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
