/* pages/orders/orders.wxss —— 配色与付费页保持一致（浅色卡片流） */

.container {
  padding: 24rpx 24rpx 60rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 20rpx;
}

/* ---------- 空态 ---------- */
.empty { text-align: center; padding: 20rpx 0; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #222; }
.empty-sub { font-size: 24rpx; color: #888; margin: 12rpx 0 24rpx; }
.btn-primary {
  display: inline-block;
  background: #2b7bfa;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 14rpx 48rpx;
  border-radius: 40rpx;
}

/* ---------- 处理中提醒 ---------- */
.pending-card {
  background: #fff8e8;
  border: 1rpx solid #ffe0a3;
}
.pending-title { font-size: 28rpx; font-weight: 600; color: #a9691a; }
.pending-desc { font-size: 24rpx; color: #8a6a3a; margin: 10rpx 0 20rpx; line-height: 1.6; }
.btn-sync {
  display: inline-block;
  background: #f5a623;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
}
.btn-sync-off { background: #d8c39a; }

/* ---------- 订单条目 ---------- */
.order {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.order:last-child { border-bottom: none; padding-bottom: 4rpx; }

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.order-main { flex: 1; min-width: 0; }
.order-name { font-size: 30rpx; font-weight: 600; color: #222; }
.order-desc { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.order-amount { font-size: 32rpx; font-weight: 700; color: #222; margin-left: 20rpx; }

.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.order-time { font-size: 24rpx; color: #999; }
.order-delivered { color: #999; }

.order-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.st-delivered { background: #e8f7ee; color: #1a9c56; }
.st-paid { background: #fff2df; color: #c47a10; }
.st-created { background: #f2f3f5; color: #8a8f99; }

.order-no {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 10rpx;
}

/* ---------- 说明 ---------- */
.rule-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}
