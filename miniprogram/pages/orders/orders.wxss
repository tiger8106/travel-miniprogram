/* pages/orders/orders.wxss —— 配色与付费页保持一致（浅色卡片流） */

.container {
  padding: 24rpx 24rpx 60rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 20rpx;
}

/* ---------- 空态 ---------- */
.empty { text-align: center; padding: 20rpx 0; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #222; }
.empty-sub { font-size: 24rpx; color: #888; margin: 12rpx 0 24rpx; }
.btn-primary {
  display: inline-block;
  background: #2b7bfa;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 14rpx 48rpx;
  border-radius: 40rpx;
}

/* ---------- 处理中提醒 ---------- */
.pending-card {
  background: #fff8e8;
  border: 1rpx solid #ffe0a3;
}
.pending-title { font-size: 28rpx; font-weight: 600; color: #a9691a; }
.pending-desc { font-size: 24rpx; color: #8a6a3a; margin: 10rpx 0 20rpx; line-height: 1.6; }
.btn-sync {
  display: inline-block;
  background: #f5a623;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 40rpx;
  border-radius: 40rpx;
}
.btn-sync-off { background: #d8c39a; }

/* ---------- 订单条目 ---------- */
.order {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.order:last-child { border-bottom: none; padding-bottom: 4rpx; }

.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.order-main { flex: 1; min-width: 0; }
.order-name { font-size: 30rpx; font-weight: 600; color: #222; }
.order-desc { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.order-amount { font-size: 32rpx; font-weight: 700; color: #222; margin-left: 20rpx; }

.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.order-time { font-size: 24rpx; color: #999; }
.order-delivered { color: #999; }

.order-refund {
  font-size: 22rpx;
  color: #8a5b5b;
  margin-top: 10rpx;
}
.order-note {
  color: #666;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}
.order-note-warning { color: #bd3030; }

.order-details-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #5275ad;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f2f4f7;
}
.order-details-arrow {
  color: #8da6cc;
  font-size: 28rpx;
  margin-left: 12rpx;
}
.order-details {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin-top: 12rpx;
}
.detail-title {
  color: #8a8f99;
  font-size: 21rpx;
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.detail-row {
  display: flex;
  align-items: flex-start;
  min-height: 34rpx;
  margin-top: 8rpx;
}
.detail-label {
  flex: 0 0 150rpx;
  color: #8a8f99;
  font-size: 22rpx;
  line-height: 1.5;
}
.detail-value {
  flex: 1;
  min-width: 0;
  color: #555b66;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}
.detail-copy {
  flex: 0 0 auto;
  color: #2b7bfa;
  font-size: 22rpx;
  line-height: 1.5;
  margin-left: 12rpx;
}

/* ---------- 待支付订单的操作 ---------- */
.order-acts {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.act {
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
}
.act-del {
  color: #c0392b;
  background: #fdeceb;
}
.act-pay {
  color: #fff;
  background: #2b7bfa;
}

/* ---------- 说明 ---------- */
.rule-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}
