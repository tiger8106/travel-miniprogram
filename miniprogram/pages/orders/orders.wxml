<view class="container">

  <!-- 未登录 -->
  <view class="card" wx:if="{{!loggedIn}}">
    <view class="empty">
      <view class="empty-title">登录后查看订单</view>
      <view class="empty-sub">订单按微信账号隔离，只看得到自己的购买记录</view>
      <view class="btn-primary" bindtap="onLogin">微信登录</view>
    </view>
  </view>

  <block wx:else>
    <!-- 处理中提醒：付了钱额度没到，给一条明确出路 -->
    <view class="card pending-card" wx:if="{{pendingCount}}">
      <view class="pending-title">有 {{pendingCount}} 笔订单在「处理中」</view>
      <view class="pending-desc">支付状态正在确认。同步不会再次扣款，请勿重复付款。</view>
      <view class="btn-sync {{syncing ? 'btn-sync-off' : ''}}" bindtap="onSync">
        {{syncing ? '同步中…' : '同步订单'}}
      </view>
    </view>

    <view class="card pending-card" wx:if="{{loadError}}">
      <view class="pending-title">订单核对未完成</view>
      <view class="pending-desc">{{loadError}}。请稍后点“同步订单”；如有实际扣款，请保留支付凭证。</view>
      <view class="btn-sync" bindtap="onSync">重试同步</view>
    </view>

    <!-- 订单列表 -->
    <view class="card" wx:if="{{list.length}}">
      <view class="card-title">🧾 购买记录</view>
      <view class="order" wx:for="{{list}}" wx:key="outTradeNo">
        <view class="order-top">
          <view class="order-main">
            <view class="order-name">{{item.goodsName}}</view>
            <view class="order-desc" wx:if="{{item.goodsDesc}}">{{item.goodsDesc}}</view>
          </view>
          <view class="order-amount">{{item.amount}}</view>
        </view>
        <view class="order-bottom">
          <view class="order-time">
            <text>购买于 {{item.createdText}}</text>
            <text class="order-delivered" wx:if="{{item.deliveredText}}"> · {{item.deliveredText}}</text>
          </view>
        </view>
        <view class="order-refund" wx:if="{{item.refundText}}">{{item.refundText}}</view>
        <view class="order-note {{item.noticeClass}}" wx:if="{{item.userNotice}}">{{item.userNotice}}</view>
        <view class="order-details-toggle" data-no="{{item.outTradeNo}}" bindtap="onToggleDetails">
          <text>{{item.detailsOpen ? '收起订单详情' : '查看订单详情'}}</text>
          <text class="order-details-arrow">{{item.detailsOpen ? '⌃' : '⌄'}}</text>
        </view>
        <view class="order-details" wx:if="{{item.detailsOpen}}">
          <view class="detail-title">提供给客服或支付平台时，可使用以下信息</view>
          <view class="detail-row" wx:if="{{item.supportMerchantOrderNo}}">
            <text class="detail-label">商户订单号</text>
            <text class="detail-value" selectable="true">{{item.supportMerchantOrderNo}}</text>
            <text class="detail-copy" data-value="{{item.supportMerchantOrderNo}}" bindtap="onCopyDetail">复制</text>
          </view>
          <view class="detail-row" wx:if="{{item.supportPlatformOrderNo}}">
            <text class="detail-label">平台订单号</text>
            <text class="detail-value" selectable="true">{{item.supportPlatformOrderNo}}</text>
            <text class="detail-copy" data-value="{{item.supportPlatformOrderNo}}" bindtap="onCopyDetail">复制</text>
          </view>
          <view class="detail-row" wx:if="{{item.supportChannelOrderNo}}">
            <text class="detail-label">渠道交易号</text>
            <text class="detail-value" selectable="true">{{item.supportChannelOrderNo}}</text>
            <text class="detail-copy" data-value="{{item.supportChannelOrderNo}}" bindtap="onCopyDetail">复制</text>
          </view>
          <view class="detail-row" wx:if="{{item.supportWxTransactionNo}}">
            <text class="detail-label">微信交易号</text>
            <text class="detail-value" selectable="true">{{item.supportWxTransactionNo}}</text>
            <text class="detail-copy" data-value="{{item.supportWxTransactionNo}}" bindtap="onCopyDetail">复制</text>
          </view>
          <view class="detail-row" wx:if="{{item.supportPaidText}}">
            <text class="detail-label">实付金额</text>
            <text class="detail-value">{{item.supportPaidText}}</text>
          </view>
          <view class="detail-row" wx:if="{{item.supportPaidAtText}}">
            <text class="detail-label">支付时间</text>
            <text class="detail-value">{{item.supportPaidAtText}}</text>
          </view>
          <view class="detail-row" wx:if="{{item.supportRefundOrderNo}}">
            <text class="detail-label">退款单号</text>
            <text class="detail-value" selectable="true">{{item.supportRefundOrderNo}}</text>
            <text class="detail-copy" data-value="{{item.supportRefundOrderNo}}" bindtap="onCopyDetail">复制</text>
          </view>
          <view class="detail-row" wx:if="{{item.supportRefundWxTransactionNo}}">
            <text class="detail-label">退款交易号</text>
            <text class="detail-value" selectable="true">{{item.supportRefundWxTransactionNo}}</text>
            <text class="detail-copy" data-value="{{item.supportRefundWxTransactionNo}}" bindtap="onCopyDetail">复制</text>
          </view>
          <view class="detail-row" wx:if="{{item.supportRefundText}}">
            <text class="detail-label">退款金额</text>
            <text class="detail-value">{{item.supportRefundText}}</text>
          </view>
          <view class="detail-row" wx:if="{{item.supportRefundAtText}}">
            <text class="detail-label">退款时间</text>
            <text class="detail-value">{{item.supportRefundAtText}}</text>
          </view>
        </view>
        <!-- 只有「待支付」的订单能继续支付 / 取消；已支付的留着对账和售后 -->
        <view class="order-acts" wx:if="{{item.status === 'created'}}">
          <view class="act act-del" data-no="{{item.outTradeNo}}" bindtap="onCancel">取消订单</view>
          <view class="act act-pay" data-no="{{item.outTradeNo}}" bindtap="onPayAgain">继续支付</view>
        </view>
      </view>
    </view>

    <!-- 空态 -->
    <view class="card" wx:if="{{!loading && !list.length}}">
      <view class="empty">
        <view class="empty-title">还没有购买记录</view>
        <view class="empty-sub">新用户注册送 3 次，用完再来买也不迟</view>
        <view class="btn-primary" bindtap="onGoPay">去看看套餐</view>
      </view>
    </view>

    <!-- 说明 -->
    <view class="card">
      <view class="card-title">📋 说明</view>
      <view class="rule-item">· 权益已到账表示使用次数或会员已经生效</view>
      <view class="rule-item">· 支付确认中请勿重复付款，可点击“同步订单”</view>
      <view class="rule-item">· 如已扣款但订单未显示，请保留购买凭证并联系客服</view>
    </view>
  </block>

</view>
