/* alarm-group 分类详情页样式（抽屉/确认卡与闹钟 Tab 同款） */
.container { padding: 24rpx 24rpx 60rpx; }
.loading { padding: 120rpx 0; text-align: center; color: var(--text-placeholder); font-size: 26rpx; }
.head-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 20rpx; padding: 28rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.head-icon { font-size: 44rpx; margin-right: 22rpx; }
.head-main { flex: 1; }
.head-title { font-size: 31rpx; font-weight: 700; color: var(--text-primary); }
.head-sub { margin-top: 6rpx; font-size: 22rpx; color: var(--text-placeholder); }
.head-add {
  padding: 12rpx 24rpx; border-radius: 999rpx;
  background: var(--primary, #1989fa); color: #fff; font-size: 24rpx;
}
.empty { padding: 140rpx 0; text-align: center; color: var(--text-secondary); font-size: 27rpx; }
.empty-icon { font-size: 72rpx; display: block; margin-bottom: 20rpx; }
.empty-sub { margin-top: 12rpx; font-size: 23rpx; color: var(--text-placeholder); }
.list { margin-top: 8rpx; }

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  animation: fade-in 0.2s ease-out;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes pop-in {
  from { transform: scale(0.88); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
  animation: sheet-up 0.3s cubic-bezier(0.22, 0.8, 0.3, 1);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e0e0e0;
  margin: 16rpx auto 8rpx;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 32rpx 16rpx;
}

.sheet-head-left {
  flex: 1;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
}

.sheet-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #909399;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sheet-body {
  max-height: 62vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4a4a4a;
  margin-bottom: 14rpx;
}

.field-help {
  margin-top: -6rpx;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 时间胶囊 */
.time-row-edit {
  display: flex;
  align-items: center;
}

.time-picker {
  flex: 1;
}

.time-pill {
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  display: flex;
  flex-direction: column;
  border: 2rpx solid transparent;
}

.time-pill-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 4rpx;
}

.time-pill-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

.time-dash {
  padding: 0 20rpx;
  color: #c8c9cc;
}

/* 输入框 */
/* input 必须给显式高度：只靠上下 padding 撑高会在开发者工具/部分机型上塌陷，
   占位文字被裁掉，看起来像一条空白灰条 */
.input-line {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 20rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
}

.input-area {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 88rpx;
  color: #1a1a1a;
}

.ph {
  color: #c0c4cc;
  font-size: 26rpx;
}

/* 类型 chips */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  display: flex;
  align-items: center;
  padding: 14rpx 26rpx;
  border-radius: 32rpx;
  background: #f7f8fa;
  color: #5a5a5a;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.chip-icon {
  margin-right: 8rpx;
}

.chip-on {
  background: var(--primary-light);
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}

/* 底部按钮 */
.sheet-foot {
  display: flex;
  padding: 16rpx 32rpx 8rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
}

.btn-cancel {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 44rpx;
  background: #f2f3f5;
  color: #5a5a5a;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-save {
  flex: 2;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 44rpx;
  margin-left: 24rpx;
  background: linear-gradient(135deg, #1989fa, #5cb1ff);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(25, 137, 250, 0.28);
}

/* ---------- 删除确认卡 ---------- */
.confirm-mask {
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-card {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
  animation: pop-in 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.2);
}

.confirm-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #ffebee;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.confirm-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.confirm-text {
  font-size: 27rpx;
  color: #606266;
  margin-top: 16rpx;
  line-height: 1.5;
  word-break: break-all;
}

.confirm-hint {
  font-size: 23rpx;
  color: #c0c4cc;
  margin-top: 10rpx;
}

.confirm-actions {
  display: flex;
  margin-top: 40rpx;
}

.btn-del {
  flex: 2;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 44rpx;
  margin-left: 24rpx;
  background: linear-gradient(135deg, #ff6b6b, #e74c3c);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(231, 76, 60, 0.28);
}

