/* pages/admin/admin.wxss —— 管理后台：暗色调 admin 风格，和主程序区分开 */

.page {
  min-height: 100vh;
  background: #10111a;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
  color: #e8eaf0;
  font-size: 28rpx;
}

.state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9aa0b4;
}
.state-title {
  font-size: 34rpx;
  color: #f2f4f8;
  margin-bottom: 20rpx;
}
.state-sub {
  font-size: 26rpx;
  line-height: 1.7;
  color: #8b90a4;
}
.claim-input {
  margin: 40rpx 0 24rpx;
  padding: 22rpx 24rpx;
  background: #1a1c28;
  border: 1rpx solid #2c3040;
  border-radius: 14rpx;
  color: #fff;
  font-size: 28rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #3d7dff, #6a4bff);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.ghost-btn {
  flex: 1;
  background: #1d2030;
  border: 1rpx solid #2f3448;
  color: #cfd4e4;
  text-align: center;
  padding: 22rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.card {
  background: #191b27;
  border: 1rpx solid #262a3a;
  border-radius: 20rpx;
  padding: 28rpx;
}
.who {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.who-name {
  font-size: 34rpx;
  font-weight: 600;
}
.who-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b90a4;
}
.who-stats {
  display: flex;
}
.stat {
  margin-left: 28rpx;
  text-align: center;
}
.stat-num {
  display: block;
  font-size: 34rpx;
  color: #7aa2ff;
  font-weight: 600;
}
.stat-label {
  font-size: 22rpx;
  color: #7c8195;
}

.tabs {
  display: flex;
  margin: 28rpx 0 20rpx;
  background: #191b27;
  border: 1rpx solid #262a3a;
  border-radius: 16rpx;
  padding: 8rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 22rpx;
  color: #8b90a4;
  border-radius: 12rpx;
}
.payment-refresh { margin-bottom: 20rpx; }
.payment-summary {
  background: #191b27;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
  color: #cfd4e4;
  font-size: 24rpx;
  line-height: 1.8;
}
.payment-error { color: #ff9aa8; font-size: 24rpx; margin: 12rpx 0; }
.payment-order .user-meta { overflow-wrap: anywhere; }
.tab-on {
  background: #2b3050;
  color: #fff;
}

.panel {
  display: block;
}

.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.search-input {
  flex: 1;
  background: #1a1c28;
  border: 1rpx solid #2c3040;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  color: #fff;
  font-size: 28rpx;
}
.search-btn {
  margin-left: 16rpx;
  padding: 20rpx 32rpx;
  background: #2b3050;
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.user-card {
  background: #191b27;
  border: 1rpx solid #262a3a;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
}
/* 卡片头：名字/信息在左，状态标签在右 */
.user-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.user-main {
  flex: 1;
  min-width: 0;
}
.user-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.user-meta {
  font-size: 24rpx;
  color: #84899d;
  line-height: 1.6;
}
/* 操作行：卡片底部右侧，横向胶囊按钮 */
.user-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}
.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}
.tag-admin { background: #4a2b6b; color: #d9b8ff; }
.tag-on { background: #1e4a37; color: #7ee2b0; }
.tag-off { background: #242736; color: #8b90a4; }
.act-btn {
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  text-align: center;
}
.act-btn + .act-btn {
  margin-left: 16rpx;
}
.act-on { background: #2f5fd0; color: #fff; }
.act-off { background: #3a2530; color: #ff9aa8; border: 1rpx solid #5a3040; }
.act-admin { background: transparent; color: #d9b8ff; border: 1rpx solid #54407a; }

.danger-btn {
  background: #2a1b20;
  border: 1rpx solid #5a3040;
  color: #ff9aa8;
  text-align: center;
  padding: 20rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  margin-bottom: 18rpx;
}

.hint-bar {
  background: #1c1f2c;
  border: 1rpx dashed #33384c;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: #949ab0;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.cfg-item {
  background: #191b27;
  border: 1rpx solid #262a3a;
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
}
.cfg-head {
  display: flex;
  align-items: center;
}
.cfg-label {
  font-size: 29rpx;
  font-weight: 600;
}
.cfg-flag {
  margin-left: 14rpx;
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #1e4a37;
  color: #7ee2b0;
}
.cfg-flag-env {
  background: #242736;
  color: #8b90a4;
}
.cfg-input {
  margin-top: 16rpx;
  background: #12141d;
  border: 1rpx solid #2c3040;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  color: #fff;
  font-size: 26rpx;
}
.cfg-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 12rpx;
}
.cfg-hint {
  flex: 1;
  font-size: 22rpx;
  color: #7c8195;
  line-height: 1.5;
}
.cfg-reset {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #7aa2ff;
}

.cfg-actions {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}
.cfg-actions .primary-btn {
  margin-bottom: 16rpx;
}
.cfg-actions .ghost-btn {
  flex: none;
  margin-bottom: 16rpx;
}
.cfg-updated {
  font-size: 22rpx;
  color: #6e7386;
  text-align: center;
}

.log-row {
  background: #191b27;
  border: 1rpx solid #262a3a;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
}
.log-main {
  display: flex;
  align-items: center;
}
.log-action {
  font-size: 27rpx;
  color: #cfd4e4;
}
.log-target {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: #7aa2ff;
}
.log-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e7386;
}

.empty {
  text-align: center;
  padding: 60rpx;
  color: #6e7386;
  font-size: 26rpx;
}

/* 配置分组卡片：大模型 / 高德 / 其他高级项，三张统一视觉 */
.cfg-card {
  background: #191b27;
  border: 1rpx solid #262a3a;
  border-radius: 20rpx;
  padding: 6rpx 24rpx 14rpx;
  margin-bottom: 20rpx;
}
.cfg-card-head {
  padding: 22rpx 2rpx 18rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #c3c9da;
}
.cfg-card-head-tap {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
/* 卡片内的配置项：去掉独立卡片底色，用分隔线区隔 */
.cfg-item-inner {
  padding: 20rpx 0 4rpx;
  border-top: 1rpx solid #22263a;
}

.cfg-adv-arrow {
  font-size: 24rpx;
  font-weight: 400;
  color: #6b7386;
}
