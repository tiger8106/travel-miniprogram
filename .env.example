# ============================================
# 云函数环境变量配置示例
# ============================================
# 在微信云开发控制台 → 云函数 → 函数配置 → 环境变量 中设置以下变量
# 每个云函数（parseTravelPlan / suggestions）都要单独配

# ============================================================
# 配置方案 A：通义千问 Qwen-Plus ★ 当前使用（非推理模型，1.7s/次）
# ------------------------------------------------------------
# 别用 qwen3.5-plus 之类的推理模型：实测单次 106s，云函数 60s 上限
# 一到整天解析被砍掉，表现为「部分行程解析不全」。
# ============================================================
LLM_PROVIDER=qwen
LLM_API_KEY=<填你的通义千问 DashScope API Key>
LLM_MODEL=qwen-plus
# LLM_BASE_URL 留空即可，默认走 DashScope 兼容接口

# ============================================================
# 配置方案 B：MiniMax-M3（如果 MiniMax 给你开放了 API）
# ============================================================
# LLM_PROVIDER=minimax
# LLM_API_KEY=<填 MiniMax API Key>
# LLM_MODEL=MiniMax-M3
# LLM_BASE_URL=https://api.minimaxi.com/v1   ← 如果默认地址不通，改这里

# ============================================================
# 备选：DeepSeek（便宜、中文强）
# ============================================================
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxxxxxxxx
# LLM_MODEL=deepseek-chat

# ============================================================
# 备选：OpenAI
# ============================================================
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# ============================================================
# 备选：腾讯混元（在微信云开发里走内网更快）
# ============================================================
# LLM_PROVIDER=hunyuan
# LLM_API_KEY=<腾讯云 API Key>
# LLM_MODEL=hunyuan-pro

# ============================================================
# 订阅消息模板（可选，用于后台闹钟推送）
# ============================================================
SUBSCRIBE_TEMPLATE_ID=

# ============================================================
# 高德地图 Web 服务 Key（地图导航需要）
# ============================================================
# 作用：把行程里的地点名（如"梵泊美地酒店"）转成经纬度，
#       小程序端就能用微信原生地图打开并跳到手机里的高德 App 导航。
# 申请：lbs.amap.com → 注册 → 应用管理 → 创建新应用 → 添加 Key →
#       服务平台选「Web服务」（不是 JS API！）
# 不配也能用，只是地图功能降级为"复制路线文本"。
# 注意：只需要配在 parseTravelPlan 这一个云函数上。
AMAP_KEY=